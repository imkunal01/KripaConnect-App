# =============================================================================
# KripaConnect Master Environment Variables Template
# =============================================================================
# Copy the relevant sections to:
#   - backend/.env
#   - frontend/.env
#   - RAG_kc/.env
#
# IMPORTANT: Never commit actual secret keys or credentials to Git repositories.
# =============================================================================

# =============================================================================
# 1. BACKEND SERVICE (backend/.env)
# =============================================================================

# Server Environment & Port
PORT=5000
NODE_ENV=development

# MongoDB Connection String (Atlas or Local)
# Example Local: mongodb://localhost:27017/kripaconnect
# Example Atlas: mongodb+srv://<user>:<password>@cluster0.mongodb.net/kripaconnect?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/kripaconnect

# Upstash Redis (REST API credentials for caching)
# Obtain from https://console.upstash.com/
UPSTASH_REDIS_REST_URL=https://your-upstash-redis-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token_here

# Fallback Redis Connection (if using self-hosted Redis instead of Upstash)
REDIS_URL=redis://localhost:6379

# JSON Web Token (JWT) Secrets
# Generate using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_jwt_access_secret_key_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here

# Frontend Application URLs & CORS Whitelist (Comma-separated)
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://kripaconnect.in,https://kripa-connect-app.vercel.app

# Cloudinary Media Storage (for product and banner image uploads)
# Obtain from https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Razorpay Payment Gateway
# Test keys begin with 'rzp_test_', Live keys begin with 'rzp_live_'
# Obtain from https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# SendGrid Transactional Email & OTP Service
# Obtain from https://app.sendgrid.com/settings/api_keys
SENDGRID_API_KEY=SG.your_sendgrid_api_key_here
SENDGRID_FROM_EMAIL=noreply@kripaconnect.in

# Google OAuth 2.0 (Identity Services)
# Obtain from https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# RAG Recommendation Microservice Link
RAG_SERVICE_URL=http://localhost:8000/api/recommend
RAG_TIMEOUT_MS=3500


# =============================================================================
# 2. FRONTEND CLIENT (frontend/.env)
# =============================================================================

# API Gateway Base URL
VITE_API_BASE_URL=http://localhost:5000

# Google OAuth Client ID for React OAuth Provider
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Backend Google OAuth Endpoint
VITE_GOOGLE_OAUTH_URL=http://localhost:5000/api/auth/google/oauth


# =============================================================================
# 3. RAG RECOMMENDATION MICROSERVICE (RAG_kc/.env)
# =============================================================================

# Backend Products API (used by RAG service to ingest & sync catalog)
PRODUCTS_API_URL=http://localhost:5000/api/products
PRODUCTS_API_TIMEOUT_SECONDS=2.0
PRODUCTS_SYNC_INTERVAL_SECONDS=30

# Primary LLM Provider — Groq
# Obtain from https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Secondary LLM Provider Fallback — Google Gemini
# Obtain from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-flash-latest

# Vector Database — Pinecone (Optional: falls back to local in-memory search if empty)
# Obtain from https://app.pinecone.io/
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=kripaconnect-products
PINECONE_NAMESPACE=products
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
PINECONE_TOP_K_DEFAULT=10

# Microservice Admin Key (used to trigger manual re-indexing)
ADMIN_API_KEY=admin_dev_secret_key


# =============================================================================
# 4. KAFKA REAL-TIME DELIVERY STREAMING (Roadmap)
# =============================================================================

# Managed Kafka Broker (e.g. Upstash Kafka, Confluent Cloud)
KAFKA_BROKER_URL=your-kafka-broker.upstash.io:9092
KAFKA_USERNAME=your_kafka_username
KAFKA_PASSWORD=your_kafka_password
KAFKA_TOPIC_LOCATION=delivery-location-updates
